{
  "name": "kai-firefox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kai for Firefox: the browser as Kai's hands and eyes",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "lint": "web-ext lint --source-dir=extension",
    "sign": "node scripts/sign.mjs",
    "publish:gitlab": "node scripts/publish-gitlab.mjs",
    "test": "node tests/run.mjs",
    "test:unit": "node tests/run.mjs --unit",
    "test:publish": "python3 scripts/publish_github_test.py"
  },
  "devDependencies": {
    "@mozilla/readability": "0.6.0",
    "dom-accessibility-api": "0.7.1",
    "esbuild": "0.28.2",
    "web-ext": "10.8.0"
  }
}
